{
  "name": "whatisthatbuilding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:https": "npm run dev:https -w web",
    "build": "npm run typecheck && npm run build -w web",
    "preview": "npm run preview -w web",
    "preview:https": "npm run preview:https -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
