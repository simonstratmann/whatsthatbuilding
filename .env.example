# Copy to .env.local (ignored by git) for `npm run dev`, `npm run import:hamburg` and
# `npm run preload:niedersachsen`.

# The PostGIS database holding the LoD2 building model; docker-compose.local.yml runs this one.
DATABASE_URL=postgres://building:building@localhost:5432/building

# Where downloaded LoD2 GML files are kept (Hamburg alone is about 7 GB; Niedersachsen's
# tiles are added as Snapshots need them, up to 50 MB each).
LOD2_CACHE_DIR=./cache/lod2

# The Overpass interpreter building names come from. Only the server asks it, so it needs no
# CORS headers and can be plain HTTP on your network. Empty uses the public server at
# https://overpass-api.de/api/interpreter.
OVERPASS_URL=
