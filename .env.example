# Copy to .env.local (ignored by git) and fill in to use your own Overpass server.
# The server (and `npm run dev`, which runs it) asks it for building data; the browser never
# calls it, so it needs no CORS headers and can be plain HTTP on your network.
# Without it the server uses the public server at https://overpass-api.de/api/interpreter.
OVERPASS_URL=https://overpass.example.org/api/interpreter
