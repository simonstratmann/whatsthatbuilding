{
  "name": "@whatisthatbuilding/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --configLoader runner",
    "dev:https": "vite --host --mode https --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host --configLoader runner",
    "preview:https": "vite build --mode https --configLoader runner && vite preview --host --mode https --configLoader runner",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.3.5",
    "@whatisthatbuilding/server": "0.1.0",
    "@hono/node-server": "^2.1.6"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "@whatisthatbuilding/shared": "0.1.0"
  }
}
